# Copy to .env. Only OPENAI_API_KEY is required to run the web app locally.
# .env is gitignored; never commit real values.

# --- Database -------------------------------------------------------------
# Supabase: Project -> Connect -> "Session pooler" (port 5432, not the 6543 transaction pooler).
# Unset uses SQLite in BA_DATA_DIR.
# BA_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- LLM ---------------------------------------------------------------
# The model runs the conversation with tool calling. It can search and propose; only the user's
# confirmation of the card (checked in code) books, cancels or moves anything.
OPENAI_API_KEY=sk-...
BA_LLM_MODEL=gpt-6-luna
BA_LLM_REASONING_EFFORT=none
# Model for memory updates. Unset uses BA_LLM_MODEL.
# BA_MEMORY_MODEL=gpt-6-luna
# USD per million tokens, for cost in traces. gpt-6-luna: $0.10 in / $0.50 out (OpenAI list price, Nov 2026).
# Tool calls on chat completions need BA_LLM_REASONING_EFFORT=none for this model.
BA_LLM_PRICE_IN_PER_M=0.10
BA_LLM_PRICE_OUT_PER_M=0.50
# OpenRouter instead: BA_LLM_BASE_URL=https://openrouter.ai/api/v1 and OPENROUTER_API_KEY=sk-or-...

# --- Access ---------------------------------------------------------------
# Set before any public deployment: the UI and API ask for this code.
# BA_ACCESS_CODE=change-me
# Enables the admin page at /admin/ (traces, bookings, settings, demo controls). Leave unset to disable it.
# Set to enable /admin/.
# BA_ADMIN_CODE=change-me-too

# --- Runtime --------------------------------------------------------------
BA_DATA_DIR=data
BA_SEED=7
BA_WATCHER_INTERVAL_S=30
BA_LOG_LEVEL=INFO

# Demo identity/header and mock controls. Disable when embedding with real authentication.
BA_DEMO_MODE=true
